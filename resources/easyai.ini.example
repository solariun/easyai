; ============================================================
; easyai.ini — operator config for easyai-server
; ============================================================
;
; PRECEDENCE
;   command-line flag   >   INI value   >   hardcoded default
;
; The server reads this file from `/etc/easyai/easyai.ini` by
; default. Override with --config <path>. A missing file is NOT
; an error — the server runs on defaults plus whatever flags were
; passed on the command line.
;
; FORMAT
;   ;   line comment (whole line)
;   #   alternate line comment marker
;   [section]
;   key = value
;
;   Boolean values accept: true / false, on / off, yes / no, 1 / 0
;   List values are comma-separated (only `override_kv` today).
;
; This file is a REFERENCE — every line is commented out. Uncomment
; only what you actually want to change. The production INI shipped
; by scripts/install_easyai_server.sh is a tuned subset of this.

; ============================================================
; [SERVER] — HTTP listener, identity, security gates, MCP
; ============================================================
[SERVER]

; ---------- core paths / identity ----------

; Path to the GGUF model file. Required. The installer puts
; models under /var/lib/easyai/models/. Use either an absolute
; path or one relative to the unit's WorkingDirectory.
;model            = /var/lib/easyai/models/qwen3.gguf

; HTTP bind address. 127.0.0.1 = loopback only (recommended when
; the box also runs a reverse proxy). 0.0.0.0 = listen on every
; interface — needs --api-key set.
;host             = 127.0.0.1

; TCP port. Default 8080. Match nginx upstream / firewall rules.
;port             = 8080

; Public model id reported by /v1/models. Lets clients hard-code
; one name (e.g. "EasyAi") regardless of the actual GGUF file.
;alias            = EasyAi

; Sandbox root for the file-work tools (`fs`, `python3`, `bash`)
; when allow_fs / allow_bash is on. Operations outside this dir
; are rejected. Default empty = no file work allowed.
;sandbox          = /var/lib/easyai/workspace

; Path to a file containing the system prompt (persona). When
; missing, the server uses its built-in "Deep" prompt. The
; installer drops a `/etc/easyai/system.txt_template` reference;
; `sudo cp` to system.txt to activate.
;system_file      = /etc/easyai/system.txt

; Inline system prompt — mutually exclusive with system_file
; (system_file wins if both are set).
;system_inline    = You are Deep — terse, honest. Lead with the answer.

; Directory containing operator-defined EASYAI-<name>.tools
; manifest files. Empty = no external tools registered.
;external_tools   = /etc/easyai/external-tools

; RAG / persistent registry directory. When set, the memory_*
; tools (rag_save / search / load / list / delete / keywords)
; auto-register. One Markdown file per entry. Legacy key `rag`
; is still read for backwards compat; prefer `memory`.
;memory           = /var/lib/easyai/rag

; Bearer token required on every /v1/* route. Empty = open
; (loopback only — never run open on 0.0.0.0). Generate:
;   openssl rand -hex 32
;api_key          = REPLACE-WITH-OPENSSL-RAND-HEX-32

; Serve https with this PEM certificate + key (both needed). Browsers
; allow the microphone only on https or localhost. Self-signed is fine
; on a LAN. Also --tls-cert / --tls-key.
;tls_cert         = /etc/easyai/tls/cert.pem
;tls_key          = /etc/easyai/tls/key.pem

; Hard cap on the HTTP request body, in bytes. Above this the
; server returns 413. Default 32 MiB.
;max_body         = 33554432

; ---------- toggles ----------

; Expose Prometheus /metrics endpoint.
;metrics          = true

; Verbose stderr: raw request / response bodies, tool dispatch
; traces, KV-cache fill gauge. Equivalent to -v.
;verbose          = false

; Allow the `fs` tool to register. Requires `sandbox` to also be
; set (operations are scoped to that dir).
;allow_fs         = false

; Allow the `bash` tool to register. WARNING: NOT a hardened
; sandbox — commands run as the easyai system user. Auto-implies
; `fs` and `python3` registration.
;allow_bash       = false

; The python3 tool defaults ON; setting this to off in the INI
; (or passing --no-python) opts out even when sandbox / allow_bash
; would auto-register it.
;allow_python     = true

; Enable engine="google" in the unified `web` tool. Requires
; GOOGLE_API_KEY + GOOGLE_CSE_ID env vars on the unit; without
; them the tool silently falls back to DuckDuckGo.
;use_google       = false

; Disable the LOCAL built-in toolbelt. Remote tools fetched via
; mcp = <url> are unaffected. Equivalent to --no-local-tools.
;local_tools      = true

; URL of an upstream MCP server. When set, the server pulls
; that server's tools and exposes them to the model alongside
; the local toolbelt. Empty = no MCP client.
;mcp              =

; Bearer token sent on every MCP outbound request (paired with
; the `mcp = …` URL above).
;mcp_token        =

; HTTP retry budget on transient failures (connect refused, read
; timeout, 5xx). 0 disables.
;http_retries     = 5

; HTTP read+write timeout per outbound request, in seconds.
;http_timeout     = 60

; Periodic METRICS log line every N seconds. ALWAYS ON regardless
; of `verbose`. 0 disables. Default 300 (5 min).
;metrics_interval = 300

; Strip <think>…</think> blocks from streaming /v1/chat
; responses (the assistant's reasoning_content is still emitted
; as a separate field). Useful for clients that can't filter the
; inline think blocks themselves.
;no_think         = false

; Prepend a small "Today is YYYY-MM-DD HH:MM TZ" preamble to the
; system prompt on every turn — so the model can answer "what
; date is today" without a tool call.
;inject_datetime  = true

; The model's training data cutoff, formatted as YYYY-MM. Sent
; to the model as a hint inside the date/time preamble.
;knowledge_cutoff = 2024-10

; Enable the chat template's `enable_thinking` flag (Qwen3, R1
; etc. surface a <think>…</think> block when this is on).
; Default true; --no-think on the CLI flips this off.
;reasoning        = true

; MCP authentication gate. Accepts on / off / open / disabled
; etc. (case-insensitive). When off, POST /mcp is open without
; a Bearer token — useful for local dev / smoke tests, NEVER
; for prod. The CLI override is --no-mcp-auth.
;mcp_auth         = on

; ---------- webui rebrand ----------

; Display name shown in the webui chrome (browser tab + header).
;webui_title       = Deep

; Path to a custom favicon / logo (.ico / .png / .svg).
;webui_icon        = /etc/easyai/logo.svg

; Placeholder text in the input box.
;webui_placeholder = Type a message…

; webui mode: "modern" (full SvelteKit fork; embedded) | "minimal"
; (inline single-file fallback). Default modern.
;webui_mode        = modern

; ---------- MODELS dashboard (/models) ----------
; A sober web UI, linked from the chat UI, that searches HuggingFace LIVE
; for GGUF models and scores them against this machine's detected (or
; simulated) hardware (fit / speed / quality), introspects the local .gguf
; files, hot-swaps the running model, and downloads weights. Everything is
; native to easyai-server — there is no external binary and no bundled
; catalog. Full reference: MODELS.md and easyai-server.md section 7.

; Password gate for /models and all of its API routes. Empty (default)
; leaves the dashboard OPEN. Set this to require a login (a session
; cookie distinct from [SERVER] api_key, which still guards /v1/*).
;webui_password    = REPLACE-WITH-A-STRONG-PASSPHRASE

; Where GGUF weights are downloaded to and listed / deleted from, and the
; directory the dashboard introspects + hot-swaps from. Default: the
; directory the loaded --model lives in, so downloads land next to the
; models already in use.
;download_dir      = /var/lib/easyai/models

; Where the HuggingFace catalog cache is kept. Default: download_dir.
; Also --data-dir.
;data_dir          = /var/lib/easyai/models

; Most-downloaded + most-recent GGUF repos per catalog listing, 1-1000
; (default 1000). Search is always live. Also --catalog-size.
;catalog_size      = 1000

; ============================================================
; [ENGINE] — model loading + inference tunables
; ============================================================
[ENGINE]

; ---------- core load knobs ----------

; Context window size in tokens. Bigger ctx = more RAM/VRAM at
; load time. Match the model's training context (Qwen3.5-4B
; trained at 40k, Qwen3-30B at 32k, etc.).
;context          = 32768

; Number of layers to offload to GPU. -1 = auto-fit (default;
; allocates as many as fit in VRAM). 0 = CPU only. 99 = force
; ALL layers on GPU (will OOM if the model doesn't fit).
;ngl              = -1

; CPU threads for prompt processing.
;threads          = 0

; CPU threads for batched inference (prompt-eval batches). 0 =
; follow `threads`.
;threads_batch    = 0

; Logical batch size (tokens per decode step). 0 = follow ctx.
;batch            = 0

; llama-server compatibility for parallel sequences. Set >1 and
; the server warns; the easyai engine runs one sequence per
; request, not N in parallel.
;parallel         = 1

; Sampling preset — picks the default (temperature, top_p,
; top_k, min_p) bundle. Per-request overrides win. Five built-
; ins ship: deterministic / precise / balanced / creative / wild.
;preset           = precise

; ---------- compute / memory ----------

; Flash attention. Free perf on every backend that supports it.
;flash_attn       = true

; Pin the model weights in RAM. Needs `LimitMEMLOCK=infinity` on
; the unit. Pair with no_mmap = true.
;mlock            = false

; Disable mmap and read the GGUF straight into RAM. Required
; with mlock for portability. Slightly slower start-up, sometimes
; needed on network filesystems.
;no_mmap          = false

; ---------- models larger than memory ----------
; Where the weights live (easyai-server.md "Models larger than memory"):
;   auto  — default. A model that fits loads whole (the `gpu` path); one
;           whose weights exceed RAM minus a reserve (max(4 GiB, RAM/16))
;           is paged; a full-GPU load that fails is retried once paged.
;   gpu   — everything in GPU memory; mlock / no_mmap / ngl honoured.
;   paged — a MoE model's routed experts stay in the mmap'd GGUF and are
;           read from disk on demand (attention, shared experts and the KV
;           cache stay on the GPU); a dense model is split GPU / disk by
;           layers. mlock and no_mmap are ignored for the paged weights.
; Also --memory-mode. Works in a [MODEL_<pattern>] profile too.
;memory_mode      = auto

; GPU hot-expert cache for a paged MoE model (llama.cpp's MoE cache):
;   auto — the VRAM left after weights / KV / compute on a discrete GPU;
;          OFF on an iGPU / unified memory (measured slower there: the
;          cache takes RAM from the page cache and every miss is a copy).
;   off  — no cache.   <MiB> — exactly that much.
; Also --expert-cache.
;expert_cache     = auto

; Paged mode: turn off the read-ahead of routed experts (one large
; MADV_WILLNEED read per expert the router picks that is not in the
; page cache yet; +3-10% measured). Also --no-expert-prefetch.
;no_expert_prefetch = off

; Keep KV cache on CPU even with GPU layers — useful when VRAM
; is tiny.
;no_kv_offload    = false

; Use a single unified KV buffer across sequences (recent
; llama.cpp feature; mostly for speculative + parallel).
;kv_unified       = false

; KV cache data type. f16 default; quantising V saves a LOT of
; VRAM. Options: f32 / f16 / bf16 / q8_0 / q4_0 / q4_1 / q5_0 /
; q5_1 / iq4_nl.
;cache_type_k     = q8_0
;cache_type_v     = q8_0

; NUMA strategy. Empty = none. Options: distribute, isolate,
; numactl, mirror.
;numa             =

; Multi-GPU split: none | layer | row. Also -sm / --split-mode.
;split_mode       = layer

; Context extension. rope_scaling = none | linear | yarn;
; rope_freq_scale = RoPE frequency scale; yarn_orig_ctx = the model's
; original training context (0 = from the GGUF). Also --rope-scaling,
; --rope-scale, --yarn-orig-ctx.
;rope_scaling     = yarn
;rope_freq_scale  = 1.0
;yarn_orig_ctx    = 0

; GGUF metadata overrides (comma-separated `key=type:value`).
; Types: int | float | bool | str. Useful for fixing tokenizer
; or rope parameters at load time without re-quantising.
;override_kv      = tokenizer.ggml.eos_token_id=int:151645

; ---------- speculative decoding ----------

; Backend. `none` (off; default), `draft-mtp` (MTP-trained
; models only — DeepSeek V3, MimoVL, Qwen3.5/3.6), `draft-simple`,
; `draft-eagle3`, `ngram-simple` / `ngram-map-k` /
; `ngram-map-k4v` / `ngram-mod` / `ngram-cache`. Typical decode
; speedup with MTP: 1.5-2x tok/s. No second model loaded.
;spec_type        = none

; Max draft tokens per speculation step. Typical for MTP: 6.
; Default 16. Ignored when spec_type = none.
;spec_draft_n_max = 6

; Path to a separate GGUF draft model for draft-simple / draft-eagle3.
; The draft model must share the same vocabulary as the main model.
; Ignored when spec_type is none, draft-mtp, or ngram-*.
;spec_draft_model =

; ---------- chat template / reasoning (llama-server compat) ----------

; Override the GGUF's embedded chat template with a Jinja file
; on disk. The file is read once at load. Mirrors llama-server
; --chat-template-file. The installer drops a reference template
; at /etc/easyai/qwen3-think.jinja_template; `sudo cp` to
; /etc/easyai/qwen3-think.jinja to activate.
;chat_template_file = /etc/easyai/qwen3-think.jinja

; Reasoning-content extraction format:
;   none            — leave <think>…</think> inline
;   auto            — default; currently behaves like deepseek
;   deepseek        — split <think>…</think> into reasoning_content,
;                     including streaming deltas (Qwen3 / R1 default)
;   deepseek-legacy — split for sync, leave inline for streaming
;reasoning_format = deepseek

; How hard a reasoning model thinks: auto | low | medium | high |
; xhigh | max | minimal. Default max = the deepest level the chat
; template accepts. Also --reasoning-effort.
;reasoning_effort = max

; ---------- sampling (per-request overrides win) ----------

;temperature      = 0.7
;top_p            = 0.95
;top_k            = 40
;min_p            = 0.05

; Anti-loop repetition penalty (multiplicative). Default 1.15
; for thinking models. Set 1.0 to disable.
;repeat_penalty   = 1.15

; OpenAI presence penalty ([-2.0, 2.0]). Production AI box pairs
; presence=1.5 with repeat_penalty=1.0 for long agentic flows.
;presence_penalty = 0.0

; OpenAI frequency penalty ([-2.0, 2.0]). Default 0.
;frequency_penalty = 0.0

; Cap on assistant reply length. -1 = unlimited (until EOS or
; ctx full).
;max_tokens       = -1

; How many "announce-only" retries the engine does before
; bailing. 0 disables. Bump to 15-20 for weak 1-bit-quant models.
;max_incomplete_retries = 10

; Deterministic seed. 0 = random.
;seed             = 0

; ============================================================
; [MODEL_<pattern>] — per-model ENGINE overrides
; ============================================================
;
; Define per-model tuning profiles that override [ENGINE] defaults
; when the loaded model matches. The server strips the GGUF path to
; basename-without-extension, then picks the section whose name is the
; LONGEST prefix of it (case-insensitive): `[MODEL_<pattern>]` matches
; when the model name STARTS WITH `<pattern>`, so one section covers
; every quant in a family (e.g. [MODEL_Qwen3.6] applies to
; Qwen3.6-25B-A38M-Q4_K_M, Qwen3.6-25B-A38M-Q6_K, ...) and a longer,
; more specific pattern wins over a shorter one ([MODEL_Qwen3-Coder-Next]
; beats [MODEL_Qwen3]).
;
; Precedence: CLI flags > MODEL_<match> > [ENGINE] > hardcoded.
;
; `alias` is NOT a match key — it is the public model-id this profile
; advertises (via /v1/models, the webui badge, chat responses) once
; matched, OVERRIDING the [SERVER] alias above. Lets the served name
; track whichever model the box loads. A single name; an explicit
; --alias on the command line still wins.
;
; Keys are the same as [ENGINE]; omitted keys keep the [ENGINE]
; value. Below is a full reference covering EVERY key the engine
; accepts — copy, rename `TEMPLATE`, uncomment what you want.
;
;[MODEL_TEMPLATE]
;; Public model-id this profile advertises once matched, overriding
;; the [SERVER] alias. Single name; NOT a match key (matching is by
;; the [MODEL_<pattern>] prefix). --alias on the CLI still wins.
;alias               = EasyAi
;
;; --- core load ---
;context             = 32768
;ngl                 = -1
;threads             = 0
;threads_batch       = 0
;batch               = 0
;parallel            = 1
;preset              = precise
;
;; --- compute / memory ---
;flash_attn          = true
;mlock               = false
;no_mmap             = false
;memory_mode         = auto
;expert_cache        = auto
;no_expert_prefetch  = off
;no_kv_offload       = false
;kv_unified          = false
;cache_type_k        = q8_0
;cache_type_v        = q8_0
;numa                =
;split_mode          = layer
;rope_scaling        = yarn
;rope_freq_scale     = 1.0
;yarn_orig_ctx       = 32768
;override_kv         = tokenizer.ggml.eos_token_id=int:151645
;
;; --- speculative decoding ---
;spec_type           = none
;spec_draft_n_max    = 6
;spec_draft_model    =
;
;; --- chat template / reasoning ---
;chat_template_file  = /etc/easyai/qwen3-think.jinja
;reasoning_format    = deepseek
;reasoning_effort    = max
;
;; --- sampling (per-request overrides win) ---
;temperature         = 0.7
;top_p               = 0.95
;top_k               = 40
;min_p               = 0.05
;repeat_penalty      = 1.15
;presence_penalty    = 0.0
;frequency_penalty   = 0.0
;max_tokens          = -1
;max_incomplete_retries = 10
;seed                = 0

; ============================================================
; [STT] — voice transcription (whisper.cpp)
; ============================================================
;
; Serves POST /v1/audio/transcriptions (OpenAI audio shape), the mic
; chip in the chat, and the built-in assistant's ears. `model` is a
; whisper ggml-*.bin — the installer points a symlink at it that the
; /models dashboard (Local models → Voice transcription) re-points when
; you Download + Run + slink one. A missing file is NOT fatal: the
; server starts, /health reports stt_loaded=false, the route answers
; 503. Recommended for pt-BR + en on a small box: large-v3-turbo-q5_0
; (547 MB). Every key is also a flag --stt-<key>.
[STT]
;model            = /var/lib/easyai/models/stt.bin
;language         = auto
;threads          = 0

; ============================================================
; [TTS] — text-to-speech (POST /v1/audio/speech, the assistant's voice)
; ============================================================
;
; OpenAI audio shape: {input, voice: pt|en|<engine voice>, response_format:
; wav} -> audio/wav PCM16 mono. The built-in assistant speaks through the
; same engine in-process. Every key is also a flag --tts-<key with
; dashes>; `easyai-server --list-voices` prints the engine in use, its
; fallback and the 54 Kokoro voices (id, language, gender, grade).
;
;   engine          auto | kokoro | http | piper | say | espeak | none
;                   auto = kokoro when model + voices + onnxruntime + espeak-ng
;                   are found, else http when url answers, else piper, else none
;                   (espeak, the robotic voice, only when set here — never automatically).
;                   kokoro and http keep the best child-process engine as fallback.
;   kokoro_model    Kokoro-82M .onnx (natural voice, run in-process in C++)
;   kokoro_voices   its voices-v1.0.bin (54 voices; sha256 in models/tts/README.md)
;   kokoro_voice_pt Kokoro voice for Portuguese: pm_alex (default), pm_santa, pf_dora
;   kokoro_voice_en Kokoro voice for English: am_michael (default), am_fenrir, am_puck (all C+ upstream), af_heart (A, female)
;   onnxruntime     libonnxruntime shared library (opened at run time)
;   espeak_lib      libespeak-ng shared library (default: found in the apt/brew places)
;   espeak_data     espeak-ng-data directory (default: found next to the library)
;   url             engine http: base URL of another box's /v1/audio/speech
;   piper           piper binary (fallback engine)
;   voice_pt        piper .onnx / say voice / espeak voice for Portuguese (fallback)
;   voice_en        same for English (fallback)
[TTS]
;engine           = auto
;kokoro_model     = /var/lib/easyai/tts/kokoro-v1.0.onnx
;kokoro_voices    = /var/lib/easyai/tts/voices-v1.0.bin
;kokoro_voice_pt  = pm_alex
;kokoro_voice_en  = am_michael
;onnxruntime      = /opt/easyai/onnxruntime/lib/libonnxruntime.so
;espeak_lib       =
;espeak_data      =
;url              = http://other-box:8080
;piper            = /opt/easyai/piper/piper
;voice_pt         = /var/lib/easyai/tts/pt_BR-faber-medium.onnx
;voice_en         = /var/lib/easyai/tts/en_US-ryan-medium.onnx

; ============================================================
; [ASSISTANT] — the voice assistant built into easyai-server
; ============================================================
;
; Always listening on this box's microphone (since 2026-11-14 inside the
; server process; no second unit). "hello <name>" / "olá <name>" wakes
; it, a pause of pause_ms ends the question (a short rising sound says
; the question was taken), the answer is spoken sentence by sentence and
; a beep says it listens again. The dashboard (/models → Assistant)
; shows the devices and the voices, edits every key of this section in
; place and applies it live. Every key is also a flag of easyai-server
; (--assistant-<key with dashes>); flags win over this file.
;   easyai-server --list-audio-devices     what to put in mic / speaker
;   easyai-server --list-voices            the [TTS] engine and the Kokoro voices
;   easyai-server --assistant-options      every key with the value in effect
;   easyai-server --assistant-say "text"   hear the voice on the speaker, no mic needed
;
;   enabled         on | off — start the assistant with the server (the installer writes on)
;   name            wake name, said right after a call word: "hello <name>", "olá <name>"
;   call_words      csv of the words that must come right before the name (default hello, olá,
;                   alô, hallo, hola — whisper's spellings of them are built in). Empty = loose
;                   mode: hey/oi/… or the bare name wake it, which fires on ordinary talk
;   name_aliases    csv of spellings whisper produces for the name (max, easy and easyai have
;                   built-in ones); run with verbose = on and read the "heard:" lines
;   mic_gain_db     software gain on the microphone, -30..30 dB (0 = as captured). Negative when
;                   the room saturates the input (levels near 0 dB in the verbose log)
;   greeting        en | pt | off — spoken once at start-up: the assistant is online and how to call it
;   endpoint        OpenAI-compatible base URL for the chat. Empty = THIS server over loopback,
;                   with its own key and TLS setting (llama-server or OpenAI work too)
;   api_key         Bearer token for the endpoint(s); empty = this server's own key when the
;                   endpoint is this server, no key for any other host
;   model           model id sent in the request ("default" = whatever the server serves)
;   stt_endpoint    another box's /v1/audio/transcriptions (empty = the server's own whisper, in-process)
;   tts_endpoint    another box's /v1/audio/speech (empty = the server's own [TTS] engine, in-process)
;   language        auto | pt | en — forced transcription language (auto detects)
;   pause_ms        silence that ends a question (ms)
;   followup_ms     after an answer the listening beep sounds and the assistant keeps listening
;                   without the name; this much silence ends the conversation with a falling
;                   two-tone sound (0 = off)
;   max_listen_ms   longest question (ms)
;   wake_model      "server" = every burst through the server's own STT (default), or a local
;                   whisper ggml for the wake word only (the installer sets ggml-base.bin)
;   mic             ALSA capture device: default, plughw:1,0 … ("default" with no capture
;                   makes the assistant pick the first card that has one and log it)
;   speaker         ALSA playback device; "default" follows the microphone card
;   tts             auto | server | kokoro | piper | espeak | say — auto/server = the [TTS]
;                   engine in-process (or tts_endpoint); the others = a local engine here
;                   (espeak only by hand; auto never picks the robotic voice)
;   kokoro_model / kokoro_voices   local Kokoro files when tts is not the server
;   voice_pt / voice_en / piper    local fallback voices (piper .onnx, say, espeak)
;   tools           csv of built-in tools: datetime, web (empty = none)
;   external_tools  directory of EASYAI-*.tools manifests (MCP-style tools run here)
;   system          system prompt: file path or inline text (default: built-in short-answer prompt)
;   history_turns   turns kept before the conversation restarts
;   history_idle_s  idle seconds after which the conversation restarts
;   verbose         on = log VAD levels, every transcript the wake model heard, timings
;   tls_insecure    on = skip certificate verification (self-signed https endpoint)
[ASSISTANT]
;enabled          = on
;name             = max
;call_words       = hello, olá, alô, hallo, hola
;name_aliases     =
;mic_gain_db      = 0
;greeting         = en
;endpoint         =
;api_key          =
;model            = default
;stt_endpoint     =
;tts_endpoint     =
;language         = auto
;pause_ms         = 1500
;followup_ms      = 2000
;max_listen_ms    = 20000
;wake_model       = server
;mic              = default
;speaker          = default
;tts              = auto
;kokoro_model     =
;kokoro_voices    =
;voice_pt         =
;voice_en         =
;piper            = piper
;tools            = datetime,web
;external_tools   = /etc/easyai/external-tools
;system           = /etc/easyai/assistant_system.txt
;history_turns    = 6
;history_idle_s   = 300
;verbose          = off
;tls_insecure     = off

; ============================================================
; [MCP_USER] — Bearer-token auth for POST /mcp
; ============================================================
;
; Each line is `username = bearer_token`. The username appears
; in the audit log; the token is what clients send as
; `Authorization: Bearer <token>`. Generate:
;   openssl rand -hex 32
;
; If the section is missing or empty AND [SERVER] mcp_auth=auto,
; /mcp is OPEN. Useful for local dev. Production: define at
; least one user.
[MCP_USER]
;gustavo  = REPLACE-WITH-OPENSSL-RAND-HEX-32
;ai-agent = REPLACE-WITH-OPENSSL-RAND-HEX-32


; ============================================================
; [REMOTE_MODEL_<name>] — peer-model tools (ai-<name>)
; ============================================================
;
; Each [REMOTE_MODEL_<name>] section becomes a server-side tool
; named `ai-<name>`. The model running on THIS server can call it
; to consult ANOTHER AI model as a peer: "check my work",
; "co-solve this", "second opinion before a risky step". One
; section = one tool; add as many as you like.
;
; The tool runs SERVER-SIDE — the server is the agent. It calls
; the peer endpoint, gets the reply, and feeds it back into the
; turn. So the webui and ANY /v1/chat/completions consumer get
; the peers for free (also listed on /v1/tools). The peer URLs
; must be reachable FROM THE SERVER.
;
; Gated by the local toolbelt master switch: --no-local-tools
; (or [SERVER] local_tools = off) drops these along with the
; built-in tools.
;
; EVERY peer is OFF by default — set `enabled = true` to switch one
; on. The server dials out to NO peer until you do (so a box that
; IS ai.local never points a peer back at itself by accident).
;
; Two peers come pre-filled as named presets (url + description),
; so enabling one is a one-liner:
;   ai-local → http://ai.local      (general purpose)
;   ai-pro   → http://ai-pro.local  (harder problems)
; A section with the same <name> overrides the preset's fields.
;
; Keys (only `enabled = true` is required to switch a peer on;
; `url` is required unless a preset already supplies it):
;   enabled      true to switch this peer ON (default off)
;   url          http(s) endpoint (bare host[:port] gets http://)
;   key          Bearer token
;   model        request-body model id (default: easyai)
;   description  what this peer is good for (shown to the model)
;   temperature top_p top_k min_p max_tokens   sampling knobs
;   timeout      per-call seconds (default 300)
;   tls_insecure skip cert verify on https (dev only)
;   ca_cert_path custom CA bundle (PEM) for https

; Switch on the ai-pro preset and tweak it:
;[REMOTE_MODEL_pro]
;enabled      = true
;url          = https://ai-pro.local
;key          = sk-...
;model        = easyai
;description  = Larger reasoning model. Use for hard math, tricky logic, and final-answer checks.
;temperature  = 0.2
;timeout      = 600

; A brand-new peer (any name) — just give it enabled + url:
;[REMOTE_MODEL_bigbox]
;enabled      = true
;url          = http://bigbox.lan:9000
;description  = 72B model on the LAN for deep reasoning.

; ----------------------------------------------------------------
; Full [REMOTE_MODEL_*] reference — every key the loader accepts.
; Copy, rename `TEMPLATE`, uncomment what you want to tweak.
; Sampling knobs left commented use the peer's own defaults.
; ----------------------------------------------------------------
;[REMOTE_MODEL_TEMPLATE]
;enabled      = false
;url          = https://peer.example:8443
;key          = REPLACE-WITH-BEARER-TOKEN
;model        = easyai
;description  = What this peer is good for (shown to the model).
;temperature  = 0.2
;top_p        = 0.95
;top_k        = 40
;min_p        = 0.05
;max_tokens   = -1
;timeout      = 300
;tls_insecure = false
;ca_cert_path = /etc/easyai/peer-ca.pem
